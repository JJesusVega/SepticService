# Copy to .env.production and replace values for the production deployment.
# Only variables prefixed with VITE_ are exposed to the browser.

VITE_EMAILJS_SERVICE_ID=your_production_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_production_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_production_emailjs_public_key

# Optional contact overrides. Leave blank to use the content defaults.
VITE_CONTACT_PHONE=PRDTBD
VITE_CONTACT_EMAIL=PRDTBD@test.com