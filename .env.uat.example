# Copy to .env.uat and replace values for the UAT deployment.
# Only variables prefixed with VITE_ are exposed to the browser.

VITE_EMAILJS_SERVICE_ID=your_uat_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_uat_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_uat_emailjs_public_key

# Optional contact overrides. Leave blank to use the content defaults.
VITE_CONTACT_PHONE=TTT TBD
VITE_CONTACT_EMAIL=TTT_TBD@test.com